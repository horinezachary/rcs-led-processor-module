{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "processors": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
          "kind": { "enum": ["brompton", "coex", "vxpro", "device"] },
          "host": { "type": "string", "minLength": 1, "maxLength": 253 },
          "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
          "label": { "type": "string", "maxLength": 40 },
          "portCapacity": { "type": "integer", "minimum": 0, "maximum": 100000000 }
        },
        "required": ["id", "kind", "host", "port", "label", "portCapacity"],
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "tempWarnC": { "type": "number", "minimum": 20, "maximum": 120 },
        "tempCritC": { "type": "number", "minimum": 20, "maximum": 130 },
        "fanMinRpm": { "type": "number", "minimum": 0, "maximum": 20000 },
        "tileTempWarnC": { "type": "number", "minimum": 20, "maximum": 120 },
        "tileTempCritC": { "type": "number", "minimum": 20, "maximum": 130 },
        "tilesOfflineCritPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "unreachableAfterPolls": { "type": "number", "minimum": 1, "maximum": 20 },
        "portLoadWarnPercent": { "type": "number", "minimum": 10, "maximum": 200 }
      },
      "additionalProperties": false
    },
    "allowControls": { "type": "boolean" }
  },
  "required": ["processors", "thresholds", "allowControls"],
  "additionalProperties": false
}
