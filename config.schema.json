{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "processors": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          },
          "kind": {
            "enum": [
              "brompton",
              "coex",
              "vxpro",
              "device"
            ]
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "label": {
            "type": "string",
            "maxLength": 40
          },
          "portCapacity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "required": [
          "id",
          "kind",
          "host",
          "port",
          "label",
          "portCapacity"
        ],
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "tempWarnC": {
          "type": "number",
          "minimum": 20,
          "maximum": 120
        },
        "tempCritC": {
          "type": "number",
          "minimum": 20,
          "maximum": 130
        },
        "fanMinRpm": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000
        },
        "tileTempWarnC": {
          "type": "number",
          "minimum": 20,
          "maximum": 120
        },
        "tileTempCritC": {
          "type": "number",
          "minimum": 20,
          "maximum": 130
        },
        "tilesOfflineCritPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "unreachableAfterPolls": {
          "type": "number",
          "minimum": 1,
          "maximum": 20
        },
        "portLoadWarnPercent": {
          "type": "number",
          "minimum": 10,
          "maximum": 200
        }
      },
      "additionalProperties": false
    },
    "walls": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$"
          },
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "primary": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          },
          "backup": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          },
          "groups": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "left": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 30
                    },
                    "trunk": {
                      "type": "string",
                      "pattern": "^[A-Z]{1,2}$"
                    },
                    "ports": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32
                    },
                    "serial": {
                      "type": "string",
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                },
                "right": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 30
                    },
                    "trunk": {
                      "type": "string",
                      "pattern": "^[A-Z]{1,2}$"
                    },
                    "ports": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 32
                    },
                    "serial": {
                      "type": "string",
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                },
                "chains": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 500
                  }
                }
              },
              "required": [
                "left",
                "chains"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "primary",
          "groups"
        ],
        "additionalProperties": false
      }
    },
    "allowControls": {
      "type": "boolean"
    }
  },
  "required": [
    "processors",
    "thresholds",
    "allowControls"
  ],
  "additionalProperties": false
}
